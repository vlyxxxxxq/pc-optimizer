<UserControl x:Class="Rig.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="BACKGROUND" Style="{StaticResource CardLabel}"/>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox x:Name="AutoStartSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="AutoStart_Click"/>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontSize="14"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Starts quietly in the notification area, so automatic Game Mode is always ready."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" Click="Save_Click"/>
                        <StackPanel>
                            <TextBlock Text="Keep running when I close the window" FontSize="14"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Exit for real from the tray icon's menu."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Notifications}" Click="Save_Click"/>
                        <StackPanel>
                            <TextBlock Text="Notifications" FontSize="14"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Game Mode on/off and finished app updates."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowNowPlaying}" Click="NowPlaying_Click"/>
                        <StackPanel>
                            <TextBlock Text="Now playing in the sidebar" FontSize="14"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Song and controls for Spotify, Apple Music, YouTube and more."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="Send test" Click="TestNotification_Click" Padding="12,5"/>
                        <TextBlock Text="Check that notifications reach you (Focus / Do not disturb can hide them)."
                                   Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Backup & share -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="BACKUP &amp; SHARE" Style="{StaticResource CardLabel}"/>
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ExportButton" Content="Export setup…" Click="Export_Click" Margin="0,0,8,0"/>
                            <Button Content="Import setup…" Style="{StaticResource PrimaryButton}" Click="Import_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Move your setup to another PC, or send it to a friend" FontSize="14"/>
                            <TextBlock x:Name="BackupText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="One file with your settings, Game Mode games and profiles, applied tweaks and installed apps. It has no personal files or passwords."/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Privacy & data -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="PRIVACY &amp; DATA" Style="{StaticResource CardLabel}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="What Rig records about how you use your PC. All of it stays on this PC; nothing is sent anywhere."/>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ClipboardHistoryEnabled}" Click="Privacy_Click"/>
                        <StackPanel>
                            <TextBlock Text="Clipboard history" FontSize="14"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Last 50 copies, in memory only; password-manager copies are skipped."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ScreenTimeEnabled}" Click="Privacy_Click"/>
                        <StackPanel>
                            <TextBlock Text="Screen time tracking" FontSize="14"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Which app is in front, every few seconds; 60 days kept."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding InputStatsEnabled}" Click="Privacy_Click"/>
                        <StackPanel>
                            <TextBlock Text="Input counting" FontSize="14"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="How many keys and clicks, never which keys in which order."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="Open data folder" Click="DataFolder_Click"/>
                        <TextBlock x:Name="DataFolderText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Shortcuts -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource CardLabel}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Click any shortcut, then press your new keys. Right-click to reset or unbind. Keys are global while the action is enabled."/>
                    <ItemsControl x:Name="ShortcutList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Tag="{Binding Property}" Loaded="Shortcut_Loaded" Padding="12,6" MinWidth="170"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="Make Rig yours. Changes apply immediately." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                    <TextBlock Text="Theme" FontSize="14" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ThemeMode" SelectionChanged="ThemeMode_Changed" MinWidth="200" MaxWidth="260" HorizontalAlignment="Left" AutomationProperties.Name="Theme"/>
                    <TextBlock Text="Accent colour" FontSize="14" Margin="0,16,0,8"/>
                    <WrapPanel x:Name="AccentSwatches"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBox x:Name="AccentHex" Width="130" MaxLength="7" AutomationProperties.Name="Custom accent hexadecimal colour"/>
                        <Button Content="Apply colour" Click="ApplyAccent_Click" Margin="8,0,0,0"/><Button Content="Choose colour…" Click="PickAccent_Click" Margin="8,0,0,0"/></StackPanel>
                    <TextBlock x:Name="AppearanceStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <CheckBox Content="Accent glows" IsChecked="{Binding ThemeGlow}" Click="Appearance_Click" Margin="0,12,0,0"/>
                    <CheckBox Content="Rounded cards" IsChecked="{Binding RoundCards}" Click="Appearance_Click" Margin="0,12,0,0"/>
                    <Button Content="Reset appearance" Click="ResetAppearance_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- Modules -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="MODULES" Style="{StaticResource CardLabel}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Switch off tools you don't use. They leave the sidebar and stop any background work; your settings for them are kept."/>
                    <StackPanel x:Name="ModuleList"/>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="UPDATES" Style="{StaticResource CardLabel}"/>
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CheckUpdateButton" Content="Check now" Click="CheckUpdate_Click" Margin="0,0,8,0"/>
                            <Button x:Name="InstallUpdateButton" Content="Update now" Style="{StaticResource PrimaryButton}"
                                    Click="InstallUpdate_Click" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="UpdateTitle" Text="You're up to date" FontSize="14"/>
                            <TextBlock x:Name="UpdateText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,10,0,0" Maximum="1" Visibility="Collapsed"/>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoCheckUpdates}" Click="Save_Click"/>
                        <TextBlock Text="Check for updates automatically (once a day)" FontSize="14" VerticalAlignment="Center"/>
                    </DockPanel>

                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource CardLabel}"/>
                    <TextBlock x:Name="VersionText" Margin="0,10,0,0" FontSize="14"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Captures and saved media stay on this PC. Online tools use their respective services for updates, games, apps, and other live information."/>
                    <Button Content="Licences &amp; credits" Click="Notices_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <TextBlock x:Name="SettingsPath" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
