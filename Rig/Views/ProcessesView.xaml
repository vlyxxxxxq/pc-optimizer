<UserControl x:Class="Rig.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Processes" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Live view of what's using your CPU and memory. Updates every 2 seconds."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,20,0,12">
            <Button x:Name="EndButton" DockPanel.Dock="Right" Content="End task" Style="{StaticResource DangerButton}"
                    Click="End_Click" IsEnabled="False"/>
            <CheckBox x:Name="GroupBox" DockPanel.Dock="Right" Content="Group by app" IsChecked="True"
                      Margin="0,0,20,0" VerticalAlignment="Center" Click="Group_Click"/>
            <Grid Width="240" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="30,6,8,6"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" IsHitTestVisible="False"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" FontSize="13"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding IdText}" SortMemberPath="Count" Width="120"/>
                    <DataGridTemplateColumn Header="CPU" SortMemberPath="Cpu" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CpuText}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Height="4" Maximum="25" Value="{Binding Cpu, Mode=OneWay}"
                                                 Margin="4,0,8,0"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="MemoryBytes" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
