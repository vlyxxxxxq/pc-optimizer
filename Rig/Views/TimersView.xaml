<UserControl x:Class="Rig.Views.TimersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Timers &amp; Reminders" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Countdowns, reminders and a stopwatch. Tip: type &quot;remind me in 20 min to stretch&quot; or &quot;timer 25m focus&quot; in the command palette."/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="New timer" FontSize="15" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="1 min" Tag="1" Click="Preset_Click" Margin="0,0,6,6"/>
                            <Button Content="5 min" Tag="5" Click="Preset_Click" Margin="0,0,6,6"/>
                            <Button Content="10 min" Tag="10" Click="Preset_Click" Margin="0,0,6,6"/>
                            <Button Content="25 min" Tag="25" Click="Preset_Click" Margin="0,0,6,6"/>
                            <Button Content="1 hour" Tag="60" Click="Preset_Click" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox x:Name="TimerLength" Width="90" Text="15m" Margin="0,0,8,0" ToolTip="e.g. 15m, 1h 30m, 90s"/>
                            <TextBox x:Name="TimerName" Width="160" Margin="0,0,8,0" ToolTip="Name (optional)"/>
                            <Button x:Name="StartTimerButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="StartTimer_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TimerError" Style="{StaticResource Muted}" Margin="0,6,0,0" Foreground="{DynamicResource WarnBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="New reminder" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox x:Name="ReminderText" Margin="0,12,0,0" ToolTip="What to remind you about"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton x:Name="RemindIn" Content="in" GroupName="When" IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="RemindInBox" Text="30m" Width="70" Margin="0,0,12,0"/>
                            <RadioButton x:Name="RemindAt" Content="at" GroupName="When" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="RemindAtBox" Width="70" Margin="0,0,12,0" ToolTip="e.g. 18:30 or 6:30pm"/>
                            <Button x:Name="AddReminderButton" Content="Add" Style="{StaticResource PrimaryButton}" Click="AddReminder_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ReminderError" Style="{StaticResource Muted}" Margin="0,6,0,0" Foreground="{DynamicResource WarnBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Running" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="0,8,0,0" Text="No timers or reminders right now."/>
                    <ItemsControl x:Name="ItemList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding PauseLabel}" Tag="{Binding}" Click="Pause_Click" Margin="0,0,8,0" Loaded="PauseButton_Loaded"/>
                                            <Button Content="Remove" Tag="{Binding}" Click="Remove_Click"/>
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding RemainingText}" FontSize="18" FontWeight="SemiBold" MinWidth="120"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Stopwatch" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StopwatchText" Text="0:00.0" FontSize="40" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="StopwatchStart" Content="Start" Style="{StaticResource PrimaryButton}" Click="StopwatchStart_Click" Margin="0,0,8,0"/>
                        <Button Content="Lap" Click="Lap_Click" Margin="0,0,8,0"/>
                        <Button Content="Reset" Click="StopwatchReset_Click"/>
                    </StackPanel>
                    <ItemsControl x:Name="LapList" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
