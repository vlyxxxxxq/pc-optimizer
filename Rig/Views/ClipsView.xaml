<UserControl x:Class="Rig.Views.ClipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Clips &amp; Recording" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Capture the moment. Keep what matters." Style="{StaticResource PageSubtitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="22">
                <StackPanel>
                    <DockPanel><TextBlock Text="YOUR CAPTURE STUDIO" Style="{StaticResource CardLabel}"/><TextBlock x:Name="LiveBadge" Text="READY" HorizontalAlignment="Right" Foreground="{DynamicResource AccentLightBrush}" FontWeight="SemiBold"/></DockPanel>
                    <TextBlock x:Name="StudioTitle" Text="Never miss the good part." FontSize="25" FontWeight="SemiBold" Margin="0,12,0,5"/>
                    <TextBlock x:Name="StudioStatus" Text="Turn on replay, play your game, then save the moment with one key." Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="ReplayButton" Content="Enable replay" Click="Replay_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                        <Button x:Name="SaveClipButton" Content="Save last 30 seconds" Click="SaveClip_Click" Margin="0,0,8,8"/>
                        <Button x:Name="RecordAreaButton" Content="Start recording" Click="RecordArea_Click" Margin="0,0,8,8"/>
                        <Button x:Name="RegionButton" Content="Record an area…" Click="Region_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="SessionInfo" Text="Replay stays off until you enable it. Microphone is optional." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CaptureError" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <ProgressBar x:Name="CaptureBusy" Height="3" IsIndeterminate="True" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border x:Name="RecoveryCard" Background="{DynamicResource WarnTintBrush}" CornerRadius="10" Padding="16" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel><TextBlock x:Name="RecoveryText" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"/>
                    <Button x:Name="RecoverButton" Content="Recover recordings" Click="Recover_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Expander IsExpanded="False" Foreground="{DynamicResource TextBrush}">
                    <Expander.Header><TextBlock Text="Capture settings" FontSize="16" FontWeight="SemiBold"/></Expander.Header>
                    <StackPanel x:Name="CaptureSettings" Margin="0,14,0,0">
                        <TextBlock Text="Captures the selected display, including other apps on it. Stop replay and recording to change these settings." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <StackPanel Width="220" Margin="0,0,14,12"><TextBlock Text="Display" Margin="0,0,0,6"/><ComboBox x:Name="MonitorBox" DisplayMemberPath="Name" SelectedValuePath="Index" SelectedValue="{Binding CaptureMonitor}" SelectionChanged="CaptureOption_Changed" AutomationProperties.Name="Capture display"/></StackPanel>
                            <StackPanel Width="140" Margin="0,0,14,12"><TextBlock Text="Replay length" Margin="0,0,0,6"/><ComboBox x:Name="ReplayLengthBox" SelectedItem="{Binding ReplaySeconds}" SelectionChanged="CaptureOption_Changed" AutomationProperties.Name="Replay length in seconds"/></StackPanel>
                            <StackPanel Width="180" Margin="0,0,14,12"><TextBlock Text="Quality preset" Margin="0,0,0,6"/><ComboBox x:Name="QualityBox" SelectionChanged="Quality_Changed" AutomationProperties.Name="Recording quality preset"/></StackPanel>
                        </WrapPanel>
                        <WrapPanel>
                            <StackPanel Width="140" Margin="0,0,14,12"><TextBlock Text="Maximum height" Margin="0,0,0,6"/><ComboBox x:Name="HeightBox" SelectedItem="{Binding CaptureHeight}" SelectionChanged="CaptureOption_Changed" AutomationProperties.Name="Maximum recording height"/></StackPanel>
                            <StackPanel Width="140" Margin="0,0,14,12"><TextBlock Text="Frames per second" Margin="0,0,0,6"/><ComboBox x:Name="FpsBox" SelectedItem="{Binding CaptureFps}" SelectionChanged="CaptureOption_Changed" AutomationProperties.Name="Recording frames per second"/></StackPanel>
                            <StackPanel Width="230" Margin="0,0,14,12"><TextBlock Text="{Binding CaptureMbps, StringFormat='Video bitrate: {0} Mbps'}" Margin="0,0,0,6"/><Slider Minimum="4" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CaptureMbps}" ValueChanged="CaptureLevel_Changed" AutomationProperties.Name="Video bitrate in megabits per second"/></StackPanel>
                        </WrapPanel>
                        <CheckBox Content="Show the mouse cursor" IsChecked="{Binding RecordCursor}" Click="CaptureOption_Click" Margin="0,0,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><CheckBox x:Name="SystemAudioCheck" Content="Game and system audio" IsChecked="{Binding CaptureSystemAudio}" Click="CaptureOption_Click"/>
                                <ComboBox x:Name="OutputDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CaptureOutputDevice}" SelectionChanged="CaptureOption_Changed" Margin="0,8,0,8" AutomationProperties.Name="System audio output device"/>
                                <TextBlock Text="{Binding CaptureSystemVolume, StringFormat='Volume: {0:P0}'}" FontSize="11" Margin="0,0,0,4"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding CaptureSystemVolume}" ValueChanged="CaptureLevel_Changed" AutomationProperties.Name="Game audio volume"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"><CheckBox x:Name="MicrophoneCheck" Content="Include microphone" IsChecked="{Binding CaptureMicrophone}" Click="CaptureOption_Click"/>
                                <ComboBox x:Name="MicDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CaptureMicDevice}" SelectionChanged="CaptureOption_Changed" Margin="0,8,0,8" AutomationProperties.Name="Microphone device"/>
                                <TextBlock Text="{Binding CaptureMicVolume, StringFormat='Volume: {0:P0}'}" FontSize="11" Margin="0,0,0,4"/>
                                <Slider Minimum="0" Maximum="2" Value="{Binding CaptureMicVolume}" ValueChanged="CaptureLevel_Changed" AutomationProperties.Name="Microphone volume"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Audio is mixed into the saved video. Microphone starts only when capture is running and this option is enabled." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,12" TextWrapping="Wrap"/>
                        <CheckBox Content="Enable replay automatically while Game Mode is on" IsChecked="{Binding ReplayWithGameMode}" Click="CaptureOption_Click" Margin="0,0,0,12"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Choose folder…" Click="ChooseFolder_Click" Margin="12,0,0,0"/><TextBlock x:Name="CaptureFolderText" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel><TextBlock Text="SHORTCUTS &amp; SCREENSHOTS" Style="{StaticResource CardLabel}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Margin="0,0,18,12"><TextBlock Text="Save replay" Margin="0,0,0,6"/><Button x:Name="ClipKeyButton" MinWidth="155"/></StackPanel>
                        <StackPanel Margin="0,0,18,12"><TextBlock Text="Start / stop recording" Margin="0,0,0,6"/><Button x:Name="RecordKeyButton" MinWidth="155"/></StackPanel>
                        <StackPanel Margin="0,0,18,12"><TextBlock Text="Replay on / off" Margin="0,0,0,6"/><Button x:Name="ReplayKeyButton" MinWidth="155"/></StackPanel>
                        <StackPanel Margin="0,0,18,12"><TextBlock Text="Screenshot" Margin="0,0,0,6"/><Button x:Name="ShotKeyButton" MinWidth="155"/></StackPanel>
                    </WrapPanel>
                    <DockPanel><CheckBox x:Name="HotkeySwitch" DockPanel.Dock="Left" Style="{StaticResource Switch}" Click="HotkeySwitch_Click" Margin="0,0,10,0"/><TextBlock x:Name="HotkeyText" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                    <WrapPanel Margin="0,12,0,0"><Button Content="Take screenshot in 3 s" Click="Shot_Click" Margin="0,0,8,0"/><Button Content="Open capture folder" Click="RecordFolder_Click"/></WrapPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,24,0,10"><Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click"/><TextBlock Text="Your clips" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="GalleryText" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/></DockPanel>
            <WrapPanel Margin="0,0,0,14"><TextBox x:Name="SearchBox" Width="260" TextChanged="Search_Changed" Margin="0,0,12,0" AutomationProperties.Name="Search captures" ToolTip="Search captures by name"/><ComboBox x:Name="FilterBox" Width="160" SelectionChanged="Filter_Changed" AutomationProperties.Name="Filter captures"/></WrapPanel>
            <TextBlock x:Name="EmptyGallery" Text="Your next great clip belongs here. Enable replay, then press Save replay after something happens." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <ItemsControl x:Name="Gallery"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Width="250" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,14">
                        <StackPanel><Button Click="Open_Click" Padding="0" Background="Transparent" ToolTip="Preview and trim this capture"><Button.Template><ControlTemplate TargetType="Button"><Border Height="140" Background="{DynamicResource DeepBrush}" CornerRadius="10,10,0,0" ClipToBounds="True"><Grid><Image Source="{Binding Thumb}" Stretch="UniformToFill"/><Border Background="#CC11141B" Padding="7,3" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"><TextBlock Text="{Binding Kind}" Foreground="White" FontSize="11"/></Border></Grid></Border></ControlTemplate></Button.Template></Button>
                            <StackPanel Margin="12,10,12,12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                <WrapPanel><Button Content="{Binding FavouriteGlyph}" Click="Favourite_Click" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Toggle favourite"/><Button Content="Preview / trim" Click="Open_Click" Padding="8,4" FontSize="11"/><Button Content="…" Click="ItemMenu_Click" Padding="8,4" Margin="6,0,0,0" ToolTip="More capture actions"/></WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="MoreCapturesButton" Content="Show more captures" Click="MoreCaptures_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
