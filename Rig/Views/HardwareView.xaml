<UserControl x:Class="Rig.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Score" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Hardware" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="What's inside your PC, how healthy your drives are, and how fast it all runs."/>

            <!-- Benchmark -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="BenchButton" DockPanel.Dock="Right" Content="Run benchmark" Style="{StaticResource PrimaryButton}"
                                Click="Bench_Click" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Benchmark" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BenchText" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Takes about 30 seconds. Close games first. Scores are for comparing your PC with itself over time: before and after a tweak, a new driver or cleaning the fans."/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel x:Name="DriveChoice" Margin="0,10,0,0">
                        <TextBlock Text="Disk to test:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </WrapPanel>
                    <ProgressBar x:Name="BenchProgress" Height="3" Margin="0,12,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
                    <UniformGrid Columns="5" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="CPU · 1 CORE" Style="{StaticResource CardLabel}"/><TextBlock x:Name="ScoreSingle" Text="–" Style="{StaticResource Score}"/><TextBlock Text="points" Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel><TextBlock Text="CPU · ALL CORES" Style="{StaticResource CardLabel}"/><TextBlock x:Name="ScoreMulti" Text="–" Style="{StaticResource Score}"/><TextBlock Text="points" Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel><TextBlock Text="MEMORY" Style="{StaticResource CardLabel}"/><TextBlock x:Name="ScoreMem" Text="–" Style="{StaticResource Score}"/><TextBlock Text="GB/s" Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel><TextBlock Text="DISK READ" Style="{StaticResource CardLabel}"/><TextBlock x:Name="ScoreRead" Text="–" Style="{StaticResource Score}"/><TextBlock Text="MB/s" Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel><TextBlock Text="DISK WRITE" Style="{StaticResource CardLabel}"/><TextBlock x:Name="ScoreWrite" Text="–" Style="{StaticResource Score}"/><TextBlock Text="MB/s" Style="{StaticResource Muted}"/></StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="HistoryTitle" Text="PREVIOUS RUNS" Style="{StaticResource CardLabel}" Margin="0,18,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Width="140" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding Line}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="LoadingText" Text="Reading hardware info…" Style="{StaticResource Muted}" Margin="0,16,0,0"/>

            <!-- Specs -->
            <ItemsControl x:Name="SpecList" Margin="-8,8,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="130" Style="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Drive health -->
            <Border x:Name="DrivesCard" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="DRIVE HEALTH" Style="{StaticResource CardLabel}"/>
                    <ItemsControl x:Name="DriveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                                    <DockPanel>
                                        <Border x:Name="pill" DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource GoodTintBrush}">
                                            <TextBlock x:Name="pillText" Text="{Binding Health}" FontSize="12" Foreground="{DynamicResource GoodBrush}"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal"/>
                                                <Run Text="{Binding Size, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Healthy}" Value="False">
                                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                                        <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
