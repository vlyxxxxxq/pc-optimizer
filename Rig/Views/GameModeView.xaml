<UserControl x:Class="Rig.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Rig.Services">
    <UserControl.Resources>
        <!-- One labelled row with a switch on the right -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <!-- Removable chip -->
        <DataTemplate x:Key="Chip">
            <Border Background="{DynamicResource ControlBrush}" CornerRadius="14" Padding="12,4,6,4" Margin="0,8,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    <Button Tag="{Binding}" Click="RemoveChip_Click" Padding="6,2" Margin="6,0,0,0"
                            Background="Transparent" ToolTip="Remove">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Game Mode" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Choose what changes while you play. See what gets restored afterward." Style="{StaticResource PageSubtitle}"/>
            <Border x:Name="Hero" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="22,18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Border x:Name="StateBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="10,4" Background="{DynamicResource InfoTintBrush}">
                            <TextBlock x:Name="StateBadgeText" Text="Game Mode" FontSize="11" Foreground="{DynamicResource AccentLightBrush}"/>
                        </Border>
                        <TextBlock Text="YOUR SESSION" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="HeroIcon" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource InfoTintBrush}" VerticalAlignment="Top">
                            <TextBlock x:Name="HeroGlyph" Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,20,0">
                            <TextBlock x:Name="StatusTitle" Text="Ready for your next game" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0"/>
                            <TextBlock x:Name="BoostDetail" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="ToggleButton" Content="Turn on" Click="Toggle_Click" Style="{StaticResource PrimaryButton}" Padding="20,10" MinWidth="126"/>
                            <Button x:Name="NotGameButton" Content="Not a game" Click="NotGame_Click" Background="Transparent" Margin="0,6,0,0" Visibility="Collapsed" ToolTip="Never detect this app as a game again"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="AppliedPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock x:Name="AppliedHeading" Text="APPLIED THIS SESSION" Style="{StaticResource CardLabel}" FontSize="10"/>
                        <ItemsControl x:Name="AppliedChanges" Margin="0,5,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource GoodTintBrush}" CornerRadius="6" Padding="9,5" Margin="0,4,7,0">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource GoodBrush}"/>
                            </Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="LiveStats" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                        <Border Style="{StaticResource Badge}" Margin="0,0,8,0" Padding="10,4"><TextBlock><Run Text="CPU " Foreground="{DynamicResource MutedBrush}"/><Run x:Name="LiveCpu" Text="–" FontWeight="SemiBold"/></TextBlock></Border>
                        <Border Style="{StaticResource Badge}" Margin="0,0,8,0" Padding="10,4"><TextBlock><Run Text="GPU " Foreground="{DynamicResource MutedBrush}"/><Run x:Name="LiveGpu" Text="–" FontWeight="SemiBold"/></TextBlock></Border>
                        <Border Style="{StaticResource Badge}" Margin="0" Padding="10,4"><TextBlock><Run Text="Game RAM " Foreground="{DynamicResource MutedBrush}"/><Run x:Name="LiveRam" Text="–" FontWeight="SemiBold"/></TextBlock></Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="RecoveryNotice" Background="{DynamicResource WarnTintBrush}" CornerRadius="10" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel><TextBlock x:Name="ProblemDetail" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RetryRestoreButton" Content="Try restoring again" Click="RetryRestore_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0"><TextBlock Text="Turn on when I start playing" Style="{StaticResource RowTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="Watch for supported games in focus. Stay in control of the changes in each session." Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AutoGameMode}" Click="Setting_Click" AutomationProperties.Name="Turn on when I start playing"/>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                <StackPanel>
                    <DockPanel><Button x:Name="RefreshGamesButton" DockPanel.Dock="Right" Content="Refresh games" Click="RefreshGames_Click" Padding="10,4" FontSize="12"/>
                        <TextBlock Text="Game profiles" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock Text="Give a game its own preferences. Games without a profile use your session defaults." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                    <Label Content="Choose an installed game, or type a game name" Target="{Binding ElementName=ProfileBox}" Padding="0" Margin="0,14,0,6" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileBox" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="Label" TextSearch.TextPath="Label" KeyDown="ProfileBox_KeyDown" MinWidth="160" Margin="0,0,10,0" AutomationProperties.Name="Game for a new profile"/>
                        <Button Grid.Column="1" Content="Create profile" Click="AddTypedProfile_Click" Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                    <TextBlock x:Name="ProfileStatus" Style="{StaticResource Muted}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <WrapPanel Margin="0,3,0,0"><TextBlock x:Name="ProfileHint" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,6,8,0"/>
                        <ItemsControl x:Name="ProfileSuggestions"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" ContentStringFormat="+ {0}" Tag="{Binding}" Click="AddProfile_Click" Padding="10,3" Margin="0,6,8,0" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <ItemsControl x:Name="ProfileList" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                        <Expander Background="{DynamicResource InputBrush}" Padding="12" Margin="0,10,0,0" Loaded="ProfileExpander_Loaded">
                            <Expander.Header><StackPanel><TextBlock Text="{Binding Game}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MatchPath}" Style="{StaticResource Muted}" FontSize="11" MaxWidth="450" TextTrimming="CharacterEllipsis"/></StackPanel></Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <UniformGrid Columns="2">
                                    <DockPanel Margin="0,0,20,12"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding PowerPlan}" Click="Profile_Click" AutomationProperties.Name="Use performance power plan for this game"/><TextBlock Text="Power plan" VerticalAlignment="Center"/></DockPanel>
                                    <DockPanel Margin="0,0,0,12"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Priority}" Click="Profile_Click" AutomationProperties.Name="Raise CPU priority for this game"/><TextBlock Text="CPU priority" VerticalAlignment="Center"/></DockPanel>
                                    <DockPanel Margin="0,0,20,12"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding KeepAwake}" Click="Profile_Click" AutomationProperties.Name="Block sleep for this game"/><TextBlock Text="Keep awake" VerticalAlignment="Center"/></DockPanel>
                                    <DockPanel Margin="0,0,0,12"><CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CloseApps}" Click="Profile_Click" AutomationProperties.Name="Close chosen apps for this game"/><TextBlock Text="Close chosen apps" VerticalAlignment="Center"/></DockPanel>
                                </UniformGrid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><Label Content="Display while playing" Padding="0,0,0,5" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                        <ComboBox ItemsSource="{x:Static services:DisplayModes.Choices}" SelectedItem="{Binding DisplayMode}" SelectionChanged="ProfileDisplay_Changed" MaxWidth="300" HorizontalAlignment="Left" MinWidth="210" AutomationProperties.Name="Display mode for this game"/></StackPanel>
                                    <Button Grid.Column="1" Tag="{Binding}" Content="Remove profile" Click="RemoveProfile_Click" Background="Transparent" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Changes take effect the next time Game Mode starts." Style="{StaticResource Muted}" Margin="0,12,0,0" FontSize="11"/>
                            </StackPanel>
                        </Expander>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                <StackPanel><TextBlock Text="Session defaults" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Used when a game has no profile. Applied on the next activation." Style="{StaticResource Muted}" Margin="0,5,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Left" IsChecked="{Binding BoostPowerPlan}" Click="Setting_Click" AutomationProperties.Name="Maximum performance power plan"/>
                            <TextBlock Text="Maximum performance power plan" Style="{StaticResource RowTitle}" TextWrapping="Wrap" Margin="0,10,0,4"/><TextBlock Text="Use a performance plan when one is available." Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel Grid.Column="2"><CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Left" IsChecked="{Binding BoostPriority}" Click="Setting_Click" AutomationProperties.Name="High CPU priority for the game"/>
                            <TextBlock Text="High CPU priority for the game" Style="{StaticResource RowTitle}" TextWrapping="Wrap" Margin="0,10,0,4"/><TextBlock Text="Give the detected game higher scheduling priority." Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel Grid.Column="4"><CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Left" IsChecked="{Binding KeepAwake}" Click="Setting_Click" AutomationProperties.Name="Block sleep and screensaver"/>
                            <TextBlock Text="Block sleep and screensaver" Style="{StaticResource RowTitle}" TextWrapping="Wrap" Margin="0,10,0,4"/><TextBlock Text="Keep the PC and display awake for your session." Style="{StaticResource Muted}"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Expander Margin="0,20,0,0"><Expander.Header><TextBlock Text="Advanced settings" FontSize="16" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel><TextBlock Text="Detection, custom games, background apps, overlay, and session recap." Style="{StaticResource Muted}" Margin="6,8,0,0"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Automatic -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DETECTION &amp; LIBRARIES" Style="{StaticResource CardLabel}"/>

                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding DetectFullscreen}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Treat any fullscreen app as a game" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Catches games installed elsewhere. Browsers and video players are ignored."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Content="Rescan" Click="Rescan_Click" Padding="12,4"/>
                                <TextBlock x:Name="LibrariesTitle" Text="Game libraries found" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl x:Name="LibraryList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- My games -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Add game…" Click="AddGame_Click" Padding="12,4"/>
                                <TextBlock Text="MY GAMES" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Games that weren't found automatically. Pick the game's .exe."/>
                            <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource Chip}" Tag="games">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="NOT GAMES" Style="{StaticResource CardLabel}" Margin="0,18,0,0"/>
                            <TextBlock x:Name="NoIgnored" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Apps you mark with &quot;Not a game&quot; show up here. Remove one to let it be detected again."/>
                            <ItemsControl x:Name="IgnoredList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlBrush}" CornerRadius="14" Padding="12,4,6,4" Margin="0,8,8,0"
                                                ToolTip="{Binding Value}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                <Button Tag="{Binding Value}" Click="RemoveIgnored_Click" Padding="6,2" Margin="6,0,0,0"
                                                        Background="Transparent" ToolTip="Allow again">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Boosts -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MORE SESSION OPTIONS" Style="{StaticResource CardLabel}"/>



                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="CloseAppsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding CloseApps}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Close background apps" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Only the ones you pick below."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Reopen closed apps afterwards"
                                          IsChecked="{Binding ReopenApps}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Reopen them when you're done" Style="{StaticResource RowTitle}" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Starts the program again; documents or sessions it had open aren't restored."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0">
                                <CheckBox x:Name="ForceCloseSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Force-close apps that don't respond"
                                          IsChecked="{Binding ForceCloseApps}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Force-close apps that don't close" Style="{StaticResource RowTitle}" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               Text="Off: apps are asked to close and left open if they don't (they may have unsaved work). On: they're ended, and unsaved work in them is lost."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding OverlayWithGameMode}" Click="Overlay_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Performance overlay" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="FPS, CPU, GPU, RAM and ping in a corner while you play. Click-through. Shows over borderless/windowed games."/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <RadioButton Content="↖ Top left" GroupName="OverlayCorner" Tag="0" Click="Corner_Click" x:Name="Corner0" Margin="0,0,6,6"/>
                                <RadioButton Content="↗ Top right" GroupName="OverlayCorner" Tag="1" Click="Corner_Click" x:Name="Corner1" Margin="0,0,6,6"/>
                                <RadioButton Content="↙ Bottom left" GroupName="OverlayCorner" Tag="2" Click="Corner_Click" x:Name="Corner2" Margin="0,0,6,6"/>
                                <RadioButton Content="↘ Bottom right" GroupName="OverlayCorner" Tag="3" Click="Corner_Click" x:Name="Corner3" Margin="0,0,12,6"/>
                                <Button x:Name="PreviewOverlayButton" Content="Preview" Click="PreviewOverlay_Click" Padding="12,4" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding SessionRecap}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Session recap" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="When a game closes: playtime, average FPS and 1% lows, load, and clips you saved. FPS needs admin mode."/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Recommended apps found on this PC -->
                            <DockPanel Margin="0,18,0,0">
                                <Button x:Name="AddAllButton" DockPanel.Dock="Right" Content="Pick recommended"
                                        Click="AddAllRecommended_Click" Padding="12,4" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="RUNNING RIGHT NOW" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="SuggestionHint" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               Text="Background apps that are safe to close while you play."/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="SuggestionList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,9" Margin="0,8,0,0">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                                          IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource GoodTintBrush}"
                                                                Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource GoodBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Running now" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Anything else, by process name -->
                            <TextBlock Text="OTHER APPS" Style="{StaticResource CardLabel}" Margin="0,18,0,0"/>
                            <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource Chip}" Tag="apps">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="OpenAppsLabel" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                       Text="Open right now. Click to close it during games:"/>
                            <ItemsControl x:Name="OpenAppsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Display}" ContentStringFormat="+ {0}" Tag="{Binding Process}"
                                                Click="OpenApp_Click" ToolTip="{Binding Process}"
                                                Padding="10,3" Margin="0,8,8,0" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="Add" Click="AddApp_Click" Padding="14,6" Margin="8,0,0,0"/>
                                <TextBox x:Name="AppBox" KeyDown="AppBox_KeyDown" ToolTip="Or type a process name, e.g. Steam"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activity -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVITY" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="NoActivity" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Text="Nothing yet. Start a game and Game Mode will log what it did here."/>
                            <ItemsControl x:Name="ActivityList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="70"
                                                       Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
                </StackPanel>
            </Expander>
            <Expander Margin="0,20,0,0"><Expander.Header><TextBlock Text="Session history" FontSize="16" FontWeight="SemiBold"/></Expander.Header>
            <!-- Play history -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="PLAY HISTORY" Style="{StaticResource CardLabel}"/>
                    <TextBlock x:Name="NoHistory" Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="Sessions show up here after you play a game for at least a minute with Game Mode on."/>
                    <Grid x:Name="HistoryGrid" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl x:Name="TotalsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="SessionList" Grid.Column="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock>
                                            <Run Text="{Binding Game, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                                            <Run Text="{Binding When, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
