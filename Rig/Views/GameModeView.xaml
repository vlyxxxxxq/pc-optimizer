<UserControl x:Class="Rig.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Rig.Services">
    <UserControl.Resources>
        <!-- One labelled row with a switch on the right -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <!-- Removable chip -->
        <DataTemplate x:Key="Chip">
            <Border Background="{DynamicResource ControlBrush}" CornerRadius="14" Padding="12,4,6,4" Margin="0,8,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    <Button Tag="{Binding}" Click="RemoveChip_Click" Padding="6,2" Margin="6,0,0,0"
                            Background="Transparent" ToolTip="Remove">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Game Mode" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Squeeze more out of your PC while you play. Turns on by itself when a game starts and undoes everything when you quit."/>

            <!-- Status hero -->
            <Border x:Name="Hero" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="24">
                <DockPanel>
                    <Button x:Name="ToggleButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="Turn on" Click="Toggle_Click" VerticalAlignment="Center" Padding="22,10" FontSize="14"/>
                    <Button x:Name="NotGameButton" DockPanel.Dock="Right" Content="Not a game" Click="NotGame_Click"
                            VerticalAlignment="Center" Padding="16,10" Margin="0,0,10,0" Visibility="Collapsed"
                            ToolTip="Never treat this app as a game again"/>
                    <Border x:Name="HeroIcon" Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ControlBrush}">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                                   x:Name="HeroGlyph" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="18,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Game Mode is off" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"/>
                        <TextBlock x:Name="BoostDetail" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                        <!-- Live numbers while a game is running -->
                        <StackPanel x:Name="LiveStats" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                            <Border Style="{StaticResource Badge}" Margin="0,0,8,0" Padding="10,4">
                                <TextBlock><Run Text="CPU " Foreground="{DynamicResource MutedBrush}"/><Run x:Name="LiveCpu" Text="–" FontWeight="SemiBold"/></TextBlock>
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,8,0" Padding="10,4">
                                <TextBlock><Run Text="GPU " Foreground="{DynamicResource MutedBrush}"/><Run x:Name="LiveGpu" Text="–" FontWeight="SemiBold"/></TextBlock>
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0" Padding="10,4">
                                <TextBlock><Run Text="Game RAM " Foreground="{DynamicResource MutedBrush}"/><Run x:Name="LiveRam" Text="–" FontWeight="SemiBold"/></TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Per-game profiles -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="PER-GAME PROFILES" Style="{StaticResource CardLabel}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Give a game its own boosts, e.g. close background apps only for ranked shooters. Games without a profile use the defaults below."/>
                    <ItemsControl x:Name="ProfileList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Tag="{Binding}" Click="RemoveProfile_Click" Background="Transparent"
                                                Padding="8,4" ToolTip="Remove profile" Margin="12,0,0,0">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Button>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PowerPlan}" Click="Profile_Click"/>
                                            <TextBlock Text="Power" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,14,0"/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Priority}" Click="Profile_Click"/>
                                            <TextBlock Text="Priority" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,14,0"/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepAwake}" Click="Profile_Click"/>
                                            <TextBlock Text="No sleep" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,14,0"/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseApps}" Click="Profile_Click"/>
                                            <TextBlock Text="Close apps" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="Display" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox Width="190" ItemsSource="{x:Static services:DisplayModes.Choices}" SelectedItem="{Binding DisplayMode}"
                                                          SelectionChanged="ProfileDisplay_Changed"
                                                          ToolTip="Switch the main display to this resolution and refresh rate while playing; it goes back afterwards"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock x:Name="ProfileHint" Text="Add a profile for:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,8,8,0"/>
                        <ItemsControl x:Name="ProfileSuggestions">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" ContentStringFormat="+ {0}" Tag="{Binding}" Click="AddProfile_Click"
                                            Padding="10,3" Margin="0,8,8,0" FontSize="12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="ProfileBox" Width="180" Margin="0,8,8,0" KeyDown="ProfileBox_KeyDown"
                                 ToolTip="Game name as Game Mode shows it, e.g. VALORANT"/>
                        <Button Content="Add" Click="AddTypedProfile_Click" Padding="12,4" Margin="0,8,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Play history -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="PLAY HISTORY" Style="{StaticResource CardLabel}"/>
                    <TextBlock x:Name="NoHistory" Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="Sessions show up here after you play a game for at least a minute with Game Mode on."/>
                    <Grid x:Name="HistoryGrid" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl x:Name="TotalsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="SessionList" Grid.Column="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock>
                                            <Run Text="{Binding Game, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                                            <Run Text="{Binding When, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Automatic -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="AUTOMATIC" Style="{StaticResource CardLabel}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding AutoGameMode}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Turn on when I start playing" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Kicks in when a game from your libraries is the window you're using, and switches off when it closes. Background apps like Wallpaper Engine are ignored."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding DetectFullscreen}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Treat any fullscreen app as a game" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Catches games installed elsewhere. Browsers and video players are ignored."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Content="Rescan" Click="Rescan_Click" Padding="12,4"/>
                                <TextBlock x:Name="LibrariesTitle" Text="Game libraries found" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl x:Name="LibraryList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- My games -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Add game…" Click="AddGame_Click" Padding="12,4"/>
                                <TextBlock Text="MY GAMES" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Games that weren't found automatically. Pick the game's .exe."/>
                            <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource Chip}" Tag="games">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="NOT GAMES" Style="{StaticResource CardLabel}" Margin="0,18,0,0"/>
                            <TextBlock x:Name="NoIgnored" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Apps you mark with &quot;Not a game&quot; show up here. Remove one to let it be detected again."/>
                            <ItemsControl x:Name="IgnoredList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlBrush}" CornerRadius="14" Padding="12,4,6,4" Margin="0,8,8,0"
                                                ToolTip="{Binding Value}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                <Button Tag="{Binding Value}" Click="RemoveIgnored_Click" Padding="6,2" Margin="6,0,0,0"
                                                        Background="Transparent" ToolTip="Allow again">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Boosts -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WHILE GAME MODE IS ON" Style="{StaticResource CardLabel}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding BoostPowerPlan}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Maximum performance power plan" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Ultimate or High performance. Your plan comes back afterwards."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding BoostPriority}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="High CPU priority for the game" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Background work yields to your game first."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding KeepAwake}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Block sleep and screensaver" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Great for controller play and cutscenes."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="CloseAppsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding CloseApps}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Close background apps" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Only the ones you pick below."/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding ReopenApps}" Click="Setting_Click"/>
                                <TextBlock Text="Reopen them when you're done" Style="{StaticResource RowTitle}"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding OverlayWithGameMode}" Click="Overlay_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Performance overlay" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="FPS, CPU, GPU, RAM and ping in a corner while you play. Click-through. Shows over borderless/windowed games."/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <RadioButton Content="↖ Top left" GroupName="OverlayCorner" Tag="0" Click="Corner_Click" x:Name="Corner0" Margin="0,0,6,6"/>
                                <RadioButton Content="↗ Top right" GroupName="OverlayCorner" Tag="1" Click="Corner_Click" x:Name="Corner1" Margin="0,0,6,6"/>
                                <RadioButton Content="↙ Bottom left" GroupName="OverlayCorner" Tag="2" Click="Corner_Click" x:Name="Corner2" Margin="0,0,6,6"/>
                                <RadioButton Content="↘ Bottom right" GroupName="OverlayCorner" Tag="3" Click="Corner_Click" x:Name="Corner3" Margin="0,0,12,6"/>
                                <Button x:Name="PreviewOverlayButton" Content="Preview" Click="PreviewOverlay_Click" Padding="12,4" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          IsChecked="{Binding SessionRecap}" Click="Setting_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Session recap" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="When a game closes: playtime, average FPS and 1% lows, load, and clips you saved. FPS needs admin mode."/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Recommended apps found on this PC -->
                            <DockPanel Margin="0,18,0,0">
                                <Button x:Name="AddAllButton" DockPanel.Dock="Right" Content="Pick recommended"
                                        Click="AddAllRecommended_Click" Padding="12,4" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="RUNNING RIGHT NOW" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="SuggestionHint" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               Text="Background apps that are safe to close while you play."/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="SuggestionList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,9" Margin="0,8,0,0">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0"
                                                          IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource GoodTintBrush}"
                                                                Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource GoodBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Running now" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Anything else, by process name -->
                            <TextBlock Text="OTHER APPS" Style="{StaticResource CardLabel}" Margin="0,18,0,0"/>
                            <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource Chip}" Tag="apps">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="OpenAppsLabel" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                       Text="Open right now. Click to close it during games:"/>
                            <ItemsControl x:Name="OpenAppsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Display}" ContentStringFormat="+ {0}" Tag="{Binding Process}"
                                                Click="OpenApp_Click" ToolTip="{Binding Process}"
                                                Padding="10,3" Margin="0,8,8,0" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="Add" Click="AddApp_Click" Padding="14,6" Margin="8,0,0,0"/>
                                <TextBox x:Name="AppBox" KeyDown="AppBox_KeyDown" ToolTip="Or type a process name, e.g. Steam"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activity -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVITY" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="NoActivity" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Text="Nothing yet. Start a game and Game Mode will log what it did here."/>
                            <ItemsControl x:Name="ActivityList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="70"
                                                       Style="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
