<UserControl x:Class="Rig.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Tweaks" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Hand-picked Windows settings for speed, privacy and fewer annoyances. Every switch shows the real current state and can be flipped back."/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RestorePointButton" Content="Create restore point" Click="RestorePoint_Click" Margin="0,0,10,0"/>
                        <Button Content="Apply recommended" Style="{StaticResource PrimaryButton}" Click="Recommended_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AdminText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Shown after a change that needs Explorer restarted -->
            <Border x:Name="ExplorerBanner" Margin="0,12,0,0" Padding="16,10" CornerRadius="8" Background="{DynamicResource WarnTintBrush}"
                    BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart Explorer" Click="RestartExplorer_Click" Padding="12,5"/>
                    <TextBlock Text="Some changes take effect after Windows Explorer restarts (your taskbar blinks for a second)."
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border x:Name="RebootBanner" Margin="0,12,0,0" Padding="16,10" CornerRadius="8" Background="{DynamicResource InfoTintBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Visibility="Collapsed">
                <TextBlock Text="Some changes take effect after you restart your PC." TextWrapping="Wrap"/>
            </Border>

            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14,18,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Tweaks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="16,0,0,0"
                                                              IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanChange}"/>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="14"/>
                                                            <Border Style="{StaticResource Badge}" Background="{DynamicResource GoodTintBrush}"
                                                                    Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource GoodBrush}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}"
                                                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Admin" FontSize="11" Foreground="{DynamicResource WarnBrush}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}"
                                                                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
