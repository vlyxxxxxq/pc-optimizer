<UserControl x:Class="Rig.Views.LayoutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Window Layouts" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Arrange your windows once, save it as a layout like Gaming, Study or Streaming, and put everything back in one click (or from the command palette)."/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Save the current arrangement" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OpenNowText" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox x:Name="NameBox" Width="240" Margin="0,0,8,0" KeyDown="NameBox_KeyDown" ToolTip="Layout name"/>
                        <Button x:Name="SaveButton" Content="Save layout" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="LaunchCheck" Content="When restoring, also open apps from the layout that aren't running" Margin="0,12,0,0" Click="LaunchCheck_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="2,12,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="2,12,0,0" Text="No layouts saved yet."/>
            <ItemsControl x:Name="LayoutList" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Restore" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="Restore_Click" Margin="0,0,8,0"/>
                                    <Button Content="Update" Tag="{Binding}" Click="Update_Click" Margin="0,0,8,0" ToolTip="Replace with the windows as they are now"/>
                                    <Button Content="Delete" Tag="{Binding}" Click="Delete_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,16,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
