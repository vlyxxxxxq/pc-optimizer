<UserControl x:Class="Rig.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Rig.Services">
    <UserControl.Resources>
        <!-- Faint horizontal guides at 25/50/75% behind each chart -->
        <ControlTemplate x:Key="ChartGrid">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1"/>
                <Border Grid.Row="2" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1"/>
                <Border Grid.Row="3" BorderBrush="{DynamicResource GridLineStrongBrush}" BorderThickness="0,0,0,1"/>
            </Grid>
        </ControlTemplate>
        <Style x:Key="CardLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Home" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="Subtitle" Text="A clear view. A few useful next steps." Style="{StaticResource PageSubtitle}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Search tools" Click="Search_Click" Margin="0,0,8,0"/>
                    <Button x:Name="CustomizeButton" Content="Customize" Click="Customize_Click"/>
                </StackPanel>
            </Grid>
            <WrapPanel x:Name="EditTools" Visibility="Collapsed" Margin="0,14,0,0">
                <Button x:Name="CompactButton" Content="Use compact layout" Margin="0,0,8,6" Click="Compact_Click"/>
                <Button x:Name="AddCardButton" Content="+ Add a card" Margin="0,0,0,6" Click="AddCard_Click"/>
            </WrapPanel>
            <WrapPanel x:Name="CardHost" Margin="-8,14,-8,0">
                <Border Tag="clips" Style="{StaticResource Card}" Margin="8" Padding="20,16">
                    <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Open capture studio" Tag="Clips" Click="Open_Click" Padding="10,5"/><TextBlock Text="CLIPS &amp; RECORDING" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/></DockPanel>
                        <TextBlock x:Name="CaptureTitle" Text="Keep the moment." FontSize="24" FontWeight="SemiBold" Margin="0,9,0,4"/>
                        <TextBlock x:Name="CaptureDetail" Text="Save a replay clip, start a recording, or open your capture library." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,12,0,0"><Button x:Name="HomeReplayButton" Content="Enable replay" Tag="replay-toggle" Click="CaptureAction_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button x:Name="HomeSaveClipButton" Content="Save clip" Tag="clip-save" Click="CaptureAction_Click" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button x:Name="HomeRecordButton" Content="Record" Tag="record-toggle" Click="CaptureAction_Click"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="GameCard" Tag="gamemode" Style="{StaticResource Card}" Margin="8" Padding="20,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border x:Name="GameBadge" DockPanel.Dock="Right" Background="{DynamicResource InfoTintBrush}" CornerRadius="6" Padding="9,4">
                                <TextBlock x:Name="GameBadgeText" Text="Game Mode" FontSize="11" Foreground="{DynamicResource AccentLightBrush}"/>
                            </Border>
                            <TextBlock Text="GAME MODE" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="GameStateText" Text="Ready for your next game" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="GameStateDetail" Style="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="GameToggleButton" Content="Turn on" Style="{StaticResource PrimaryButton}" Click="GameToggle_Click" MinWidth="128"/>
                                <Button Content="Open Game Mode" Background="Transparent" Tag="Game" Click="Open_Click" Margin="0,5,0,0" Padding="8,4" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="LastSessionPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock x:Name="LastSessionText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LastSessionDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="CpuCard" Tag="cpu" Style="{StaticResource Card}" Margin="8" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="CpuText" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        <TextBlock Text="Processor load · last 60 seconds" Style="{StaticResource Muted}" FontSize="11"/>
                        <Grid Height="25" Margin="0,9,0,0"><Control Template="{StaticResource ChartGrid}"/>
                            <Canvas x:Name="CpuChart" ClipToBounds="True"><Polygon x:Name="CpuFill" Fill="{DynamicResource AccentBrush}" Opacity="0.13"/>
                                <Polyline x:Name="CpuLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="MemoryCard" Tag="memory" Style="{StaticResource Card}" Margin="8" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="MemText" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        <TextBlock x:Name="MemDetail" Style="{StaticResource Muted}" FontSize="11"/>
                        <Grid Height="25" Margin="0,9,0,0"><Control Template="{StaticResource ChartGrid}"/>
                            <Canvas x:Name="MemChart" ClipToBounds="True"><Polygon x:Name="MemFill" Fill="{DynamicResource GoodBrush}" Opacity="0.13"/>
                                <Polyline x:Name="MemLine" Stroke="{DynamicResource GoodBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="SystemCard" Tag="system" Style="{StaticResource Card}" Margin="8" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="UPTIME" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="UptimeText" Text="–" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        <TextBlock Text="Since the last restart" Style="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock x:Name="OsText" Style="{StaticResource Muted}" FontSize="11" Margin="0,13,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border x:Name="PinsCard" Tag="pins" Style="{StaticResource Card}" Margin="8" Padding="16,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Edit shortcuts" Click="EditPins_Click" Padding="8,3" Background="Transparent" FontSize="12"/>
                            <TextBlock Text="YOUR SHORTCUTS" Style="{StaticResource CardLabel}" VerticalAlignment="Center"/></DockPanel>
                        <UniformGrid x:Name="PinnedPanel" x:FieldModifier="public" Columns="4" Margin="-4,0,-4,0"/>
                        <TextBlock x:Name="PinnedHint" x:FieldModifier="public" Style="{StaticResource Muted}" Visibility="Collapsed"
                                   Text="Choose Edit shortcuts to pin the tools you reach for most."/>
                    </StackPanel>
                </Border>
                <Border x:Name="HealthCard" Tag="health" Style="{StaticResource Card}" Margin="8" Padding="18,16">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0"><TextBlock Text="MAINTENANCE" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="MaintenanceTitle" Text="Checking your PC…" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                <TextBlock x:Name="HealthSummary" Text="Checking storage, startup apps, and current load." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="RecheckButton" Grid.Column="1" Content="Check again" Click="Recheck_Click" VerticalAlignment="Top"/>
                        </Grid>
                        <ItemsControl x:Name="FindingsList" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,9" Margin="0,6,0,0"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
                                <Button Grid.Column="2" Content="{Binding ActionLabel}" Tag="{Binding Action}" Click="Finding_Click" Padding="10,5" VerticalAlignment="Center"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Button x:Name="MoreFindingsButton" Content="Show all checks" Click="MoreFindings_Click" Background="Transparent" HorizontalAlignment="Left" Padding="0,7" Margin="0,5,0,0" Visibility="Collapsed" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border x:Name="RecentCard" Tag="recent" Style="{StaticResource Card}" Margin="8" Padding="16,14">
                    <StackPanel><TextBlock Text="RECENT TOOLS" Style="{StaticResource CardLabel}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RecentEmpty" Text="Tools you open will appear here for this session." Style="{StaticResource Muted}"/>
                        <UniformGrid x:Name="RecentPanel" Columns="4" Margin="-4,0,-4,0"/>
                    </StackPanel>
                </Border>
                <!-- Now playing -->
                <Border x:Name="MusicCard" Tag="music" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="NOW PLAYING" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="SongText" Text="Nothing playing" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Style="{StaticResource Muted}" Text="Spotify, Apple Music, YouTube and more" TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="MusicButtons" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Tag="prev" Click="Music_Click" Margin="0,0,8,0" ToolTip="Previous"/>
                            <Button Content="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Tag="play" Click="Music_Click" Margin="0,0,8,0" ToolTip="Play / pause" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Tag="next" Click="Music_Click" ToolTip="Next"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Screen time -->
                <Border x:Name="ScreenTimeCard" Tag="screentime" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="SCREEN TIME TODAY" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="ScreenTimeText" Text="–" Style="{StaticResource BigNumber}"/>
                        <TextBlock x:Name="ScreenTimeDetail" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Open Screen Time" Style="{StaticResource CardLink}" Tag="ScreenTime" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Input -->
                <Border x:Name="InputCard" Tag="input" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="INPUT TODAY" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="InputText" Text="–" Style="{StaticResource BigNumber}"/>
                        <TextBlock x:Name="InputDetail" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Open Input Stats" Style="{StaticResource CardLink}" Tag="Input" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Timers -->
                <Border x:Name="TimersCard" Tag="timers" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="TIMERS &amp; REMINDERS" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="TimersText" Text="Nothing running" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TimersDetail" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Open Timers" Style="{StaticResource CardLink}" Tag="Timers" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Power timer -->
                <Border x:Name="PowerCard" Tag="power" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="POWER TIMER" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="PowerText" Text="Off" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <Button Content="Set it up in Tools" Style="{StaticResource CardLink}" Tag="Tools" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Free games -->
                <Border x:Name="FreeCard" Tag="freegames" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="FREE GAMES TO CLAIM" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="FreeText" Text="Checking…" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <ItemsControl x:Name="FreeList" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Platform}" Style="{StaticResource Muted}" Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Claim in Game Library" Style="{StaticResource CardLink}" Tag="Library" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Drives -->
                <Border x:Name="StorageCard" Tag="storage" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="STORAGE" Style="{StaticResource CardLabel}"/>
                        <ItemsControl x:Name="DrivesList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                        <ProgressBar Grid.Row="1" Margin="0,6,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
