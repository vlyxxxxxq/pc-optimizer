<UserControl x:Class="Rig.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Rig.Services">
    <UserControl.Resources>
        <!-- Faint horizontal guides at 25/50/75% behind each chart -->
        <ControlTemplate x:Key="ChartGrid">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1"/>
                <Border Grid.Row="2" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1"/>
                <Border Grid.Row="3" BorderBrush="{DynamicResource GridLineStrongBrush}" BorderThickness="0,0,0,1"/>
            </Grid>
        </ControlTemplate>
        <Style x:Key="CardLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="CompactButton" Content="Use compact layout" Margin="0,0,8,0" Visibility="Collapsed" Click="Compact_Click"
                            ToolTip="Just pinned tools, Game Mode and the maintenance check"/>
                    <Button x:Name="AddCardButton" Content="+ Add a card" Margin="0,0,8,0" Visibility="Collapsed" Click="AddCard_Click"/>
                    <Button x:Name="CustomizeButton" Content="Customize" Click="Customize_Click"/>
                </StackPanel>
                <TextBlock Text="Home" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock x:Name="Subtitle" Text="Your tools and your PC at a glance." Style="{StaticResource PageSubtitle}"/>

            <!-- Cards: shown, ordered and sized from settings (HomeCards); each has a Tag with its id -->
            <WrapPanel x:Name="CardHost" Margin="-8,12,-8,0">

                <!-- Pinned tools: right-click any sidebar page to pin or unpin it -->
                <Border x:Name="PinsCard" Tag="pins" Margin="8">
                    <StackPanel>
                        <TextBlock Text="PINNED" Style="{StaticResource CardLabel}" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="PinnedPanel" x:FieldModifier="public"/>
                        <TextBlock x:Name="PinnedHint" x:FieldModifier="public" Style="{StaticResource Muted}" Visibility="Collapsed"
                                   Text="Right-click any page in the sidebar and choose Pin to Home to keep it here."/>
                    </StackPanel>
                </Border>

                <!-- Health -->
                <Border x:Name="HealthCard" Tag="health" Style="{StaticResource Card}" Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="96" Height="96" VerticalAlignment="Top" ToolTip="{x:Static services:HealthReport.Basis}">
                            <Ellipse Stroke="{DynamicResource ControlBrush}" StrokeThickness="9"/>
                            <Path x:Name="ScoreArc" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ScoreText" Text="…" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ScoreLabel" Text="Checking" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                            <DockPanel>
                                <Button x:Name="RecheckButton" DockPanel.Dock="Right" Content="Re-check" Click="Recheck_Click" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="Maintenance check" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="HealthSummary" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               Text="Checking for junk files, startup load and disk space…"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="FindingsList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,8" Margin="0,6,0,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Tag="{Binding Action}"
                                                        Click="Finding_Click" Padding="12,4" VerticalAlignment="Center"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="14"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CPU -->
                <Border x:Name="CpuCard" Tag="cpu" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="last 60s" Style="{StaticResource Muted}"/>
                            <TextBlock Text="CPU" Style="{StaticResource CardLabel}"/>
                        </DockPanel>
                        <TextBlock x:Name="CpuText" Text="–" Style="{StaticResource BigNumber}"/>
                        <TextBlock Text="total processor load" Style="{StaticResource Muted}"/>
                        <Grid Height="70" Margin="0,14,0,0">
                            <Control Template="{StaticResource ChartGrid}"/>
                            <Canvas x:Name="CpuChart" ClipToBounds="True">
                                <Polygon x:Name="CpuFill" Fill="{DynamicResource AccentBrush}" Opacity="0.18"/>
                                <Polyline x:Name="CpuLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border x:Name="MemoryCard" Tag="memory" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="last 60s" Style="{StaticResource Muted}"/>
                            <TextBlock Text="MEMORY" Style="{StaticResource CardLabel}"/>
                        </DockPanel>
                        <TextBlock x:Name="MemText" Text="–" Style="{StaticResource BigNumber}"/>
                        <TextBlock x:Name="MemDetail" Style="{StaticResource Muted}"/>
                        <Grid Height="70" Margin="0,14,0,0">
                            <Control Template="{StaticResource ChartGrid}"/>
                            <Canvas x:Name="MemChart" ClipToBounds="True">
                                <Polygon x:Name="MemFill" Fill="{DynamicResource GoodBrush}" Opacity="0.18"/>
                                <Polyline x:Name="MemLine" Stroke="{DynamicResource GoodBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System -->
                <Border x:Name="SystemCard" Tag="system" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="UptimeText" Text="–" Style="{StaticResource BigNumber}"/>
                        <TextBlock Text="since last restart" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="OsText" Margin="0,16,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CpuNameText" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CoresText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Game Mode -->
                <Border x:Name="GameCard" Tag="gamemode" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="GAME MODE" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="GameStateText" Text="Off" Style="{StaticResource BigNumber}"/>
                        <TextBlock x:Name="GameStateDetail" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LastSessionText" Margin="0,16,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LastSessionDetail" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Open Game Mode" Style="{StaticResource CardLink}" Tag="Game" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Now playing -->
                <Border x:Name="MusicCard" Tag="music" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="NOW PLAYING" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="SongText" Text="Nothing playing" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Style="{StaticResource Muted}" Text="Spotify, Apple Music, YouTube and more" TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="MusicButtons" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Tag="prev" Click="Music_Click" Margin="0,0,8,0" ToolTip="Previous"/>
                            <Button Content="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Tag="play" Click="Music_Click" Margin="0,0,8,0" ToolTip="Play / pause" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Tag="next" Click="Music_Click" ToolTip="Next"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Screen time -->
                <Border x:Name="ScreenTimeCard" Tag="screentime" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="SCREEN TIME TODAY" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="ScreenTimeText" Text="–" Style="{StaticResource BigNumber}"/>
                        <TextBlock x:Name="ScreenTimeDetail" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Open Screen Time" Style="{StaticResource CardLink}" Tag="ScreenTime" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Input -->
                <Border x:Name="InputCard" Tag="input" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="INPUT TODAY" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="InputText" Text="–" Style="{StaticResource BigNumber}"/>
                        <TextBlock x:Name="InputDetail" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Open Input Stats" Style="{StaticResource CardLink}" Tag="Input" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Timers -->
                <Border x:Name="TimersCard" Tag="timers" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="TIMERS &amp; REMINDERS" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="TimersText" Text="Nothing running" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TimersDetail" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Open Timers" Style="{StaticResource CardLink}" Tag="Timers" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Power timer -->
                <Border x:Name="PowerCard" Tag="power" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="POWER TIMER" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="PowerText" Text="Off" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <Button Content="Set it up in Tools" Style="{StaticResource CardLink}" Tag="Tools" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Free games -->
                <Border x:Name="FreeCard" Tag="freegames" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="FREE GAMES TO CLAIM" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="FreeText" Text="Checking…" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <ItemsControl x:Name="FreeList" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Platform}" Style="{StaticResource Muted}" Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Claim in Game Library" Style="{StaticResource CardLink}" Tag="Library" Click="Open_Click"/>
                    </StackPanel>
                </Border>

                <!-- Drives -->
                <Border x:Name="StorageCard" Tag="storage" Style="{StaticResource Card}" Margin="8">
                    <StackPanel>
                        <TextBlock Text="STORAGE" Style="{StaticResource CardLabel}"/>
                        <ItemsControl x:Name="DrivesList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                        <ProgressBar Grid.Row="1" Margin="0,6,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
