<UserControl x:Class="Rig.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Security" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Check that Windows Security is protecting you, run a scan and keep virus definitions current."/>

            <!-- Status -->
            <Border x:Name="StatusCard" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="24">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open Windows Security" Click="OpenWs_Click" VerticalAlignment="Center"/>
                    <Border x:Name="ShieldBg" Width="64" Height="64" CornerRadius="32" Background="{DynamicResource GoodTintBrush}">
                        <TextBlock x:Name="Shield" Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                                   Foreground="{DynamicResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="18,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="Checking…" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!-- Scan -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Virus scan" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ScanText" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="ScanProgress" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="QuickButton" Content="Quick scan" Style="{StaticResource PrimaryButton}" Click="Quick_Click" Margin="0,0,8,0"/>
                            <Button x:Name="FullButton" Content="Full scan" Click="Full_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Definitions -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Virus definitions" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DefsText" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <Button x:Name="DefsButton" Content="Update now" Click="Defs_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Game exclusions -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="ExcludeButton" Content="Exclude game folders" Click="Exclude_Click" Margin="0,0,8,0"/>
                            <Button x:Name="IncludeButton" Content="Remove exclusions" Click="Include_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Game folder exclusions" FontSize="15" FontWeight="SemiBold"/>
                                <Border Style="{StaticResource Badge}"><TextBlock Text="Admin" FontSize="11" Foreground="{DynamicResource WarnBrush}"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,16,0" TextWrapping="Wrap"
                                       Text="Skipping real-time scanning in your game libraries can cut stutter when games load lots of files. The trade-off: anything malicious placed in those folders won't be caught as it's written. Only do this for games from trusted stores."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ExclusionText" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
