<UserControl x:Class="Rig.Views.ColorPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Color Picker &amp; Ruler" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Grab the colour of any pixel on screen, or measure something in pixels. The picked colour is copied as HEX straight away."/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="HotkeyButton" DockPanel.Dock="Right" Padding="10,4" FontSize="11" ToolTip="Click to change the colour picker shortcut"/>
                            <TextBlock Text="Pick a colour" FontSize="15" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="The screen freezes with a magnifier. Click a pixel (arrow keys nudge by one, Enter picks)."/>
                        <Button x:Name="PickButton" Content="Pick a colour" Style="{StaticResource PrimaryButton}" Click="Pick_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Measure" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Drag a box on screen to see its size in pixels."/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="MeasureButton" Content="Measure" Click="Measure_Click" Margin="0,0,14,0"/>
                            <TextBlock x:Name="MeasureText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear" Click="Clear_Click"/>
                        <TextBlock Text="Picked colours" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Colours you pick show up here."/>
                    <ItemsControl x:Name="History" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{Binding Brush}" Margin="0,0,14,0"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding Hex}" Tag="{Binding Hex}" Click="Copy_Click" Margin="0,0,6,0" ToolTip="Copy"/>
                                            <Button Content="{Binding Rgb}" Tag="{Binding Rgb}" Click="Copy_Click" Margin="0,0,6,0" ToolTip="Copy"/>
                                            <Button Content="{Binding Hsl}" Tag="{Binding Hsl}" Click="Copy_Click" ToolTip="Copy"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Hex}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
