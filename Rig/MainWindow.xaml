<Window x:Class="Rig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rig.Views"
        Title="Rig" Width="1220" Height="840" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <DockPanel x:Name="BrandRow" DockPanel.Dock="Top" Margin="20,20,12,16">
                    <!-- Collapse to icons only -->
                    <Button x:Name="SidebarToggle" DockPanel.Dock="Right" Style="{StaticResource MediaButton}" Content="&#xE76B;"
                            Click="SidebarToggle_Click" VerticalAlignment="Center" AutomationProperties.AutomationId="SidebarToggle"/>
                <StackPanel Orientation="Horizontal">
                    <!-- Vector copy of the app icon so it stays sharp at any DPI (an .ico gets scaled and blurs). -->
                    <Border x:Name="BrandLogo" Width="36" Height="36" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6CA0FF" Offset="0"/>
                                <GradientStop Color="#3A6BE8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Canvas Width="36" Height="36">
                            <!-- 270° dial open at the bottom, needle pointing up-right, hub -->
                            <Path Data="M10.65,26.75 A10.4,10.4 0 1 1 25.35,26.75" Stroke="White" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="18" Y1="19.4" X2="24.2" Y2="14.2" Stroke="White" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="15.3" Canvas.Top="16.7" Width="5.4" Height="5.4" Fill="White"/>
                        </Canvas>
                    </Border>
                    <StackPanel x:Name="BrandText" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Rig" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Your PC toolkit" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <!-- Shown when a newer release is on GitHub -->
                    <Border x:Name="UpdateChip" Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Padding="12,10" Cursor="Hand" Margin="0,0,0,8"
                            Visibility="Collapsed" MouseLeftButtonUp="UpdateChip_Click" ToolTip="Open Settings to update">

                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="UpdateChipTitle" Text="Update available" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Click to update" FontSize="11" Foreground="#DDE6FF"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Now playing: read from music apps and YouTube tabs; buttons send media keys -->
                    <Border x:Name="MusicChip" CornerRadius="8" Padding="12,8,6,8" Background="{DynamicResource CardBrush}" Margin="0,0,0,8"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE892;" Style="{StaticResource MediaButton}" Click="MusicPrev_Click" ToolTip="Previous"/>
                                <Button Content="&#xE769;" Style="{StaticResource MediaButton}" Click="MusicPlay_Click" ToolTip="Play / pause"/>
                                <Button Content="&#xE893;" Style="{StaticResource MediaButton}" Click="MusicNext_Click" ToolTip="Next"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="MusicTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MusicDetail" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Game Mode quick toggle -->
                    <Border x:Name="GameChip" CornerRadius="8" Padding="12,10" Background="{DynamicResource CardBrush}" Cursor="Hand"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                            MouseLeftButtonUp="GameChip_Click" ToolTip="Click to toggle Game Mode">
                        <DockPanel>
                            <Ellipse x:Name="GameDot" Width="8" Height="8" Fill="{DynamicResource MutedBrush}"
                                     DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GameChipIcon" Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel x:Name="GameChipText">
                                <TextBlock x:Name="GameChipTitle" Text="Game Mode off" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GameChipDetail" Text="Watching for games" Style="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="AdminStatus" FontSize="11" Margin="4,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Opens the command palette; same as its hotkey from anywhere -->
                <Border DockPanel.Dock="Top" Margin="16,0,16,10" Padding="12,8" CornerRadius="8" Cursor="Hand"
                        Background="{DynamicResource CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                        MouseLeftButtonUp="PaletteHint_Click" ToolTip="Search pages, actions, games and apps">
                    <DockPanel>
                        <TextBlock x:Name="PaletteKeyText" DockPanel.Dock="Right" Text="Ctrl+Alt+Space" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PaletteText" Text="Search or run…" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Built from Modules.All by MainWindow.Shell.cs -->
                <StackPanel x:Name="NavBottom" DockPanel.Dock="Bottom" Margin="0,4,0,0"/>
                <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="0,0,0,8"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Faint accent glow in the top-right corner of the content area -->
        <Border Grid.Column="1" IsHitTestVisible="False" Background="{DynamicResource AccentGlowBrush}">

        </Border>

        <!-- Pages are added here the first time they're opened -->
        <Grid Grid.Column="1" x:Name="PagesHost"/>
    </Grid>
</Window>
