<Window x:Class="PCOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCOptimizer.Views"
        Title="PC Optimizer" Width="1220" Height="840" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,20,20,16">
                    <!-- Vector copy of the app icon so it stays sharp at any DPI (an .ico gets scaled and blurs). -->
                    <Border Width="36" Height="36" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6CA0FF" Offset="0"/>
                                <GradientStop Color="#3A6BE8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Canvas Width="36" Height="36">
                            <!-- 270° dial open at the bottom, needle pointing up-right, hub -->
                            <Path Data="M10.65,26.75 A10.4,10.4 0 1 1 25.35,26.75" Stroke="White" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="18" Y1="19.4" X2="24.2" Y2="14.2" Stroke="White" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="15.3" Canvas.Top="16.7" Width="5.4" Height="5.4" Fill="White"/>
                        </Canvas>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PC Optimizer" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Keep Windows tidy" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <!-- Shown when a newer release is on GitHub -->
                    <Border x:Name="UpdateChip" CornerRadius="8" Padding="12,10" Cursor="Hand" Margin="0,0,0,8"
                            Visibility="Collapsed" MouseLeftButtonUp="UpdateChip_Click" ToolTip="Open Settings to update">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2F5FD0" Offset="0"/>
                                <GradientStop Color="#4F8CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="UpdateChipTitle" Text="Update available" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Click to update" FontSize="11" Foreground="#DDE6FF"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Game Mode quick toggle -->
                    <Border x:Name="GameChip" CornerRadius="8" Padding="12,10" Background="#1B1F2A" Cursor="Hand"
                            BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                            MouseLeftButtonUp="GameChip_Click" ToolTip="Click to toggle Game Mode">
                        <DockPanel>
                            <Ellipse x:Name="GameDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}"
                                     DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="GameChipTitle" Text="Game Mode off" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GameChipDetail" Text="Watching for games" Style="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="AdminStatus" FontSize="11" Margin="4,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Opens the command palette; same as its hotkey from anywhere -->
                <Border DockPanel.Dock="Top" Margin="16,0,16,10" Padding="12,8" CornerRadius="8" Cursor="Hand"
                        Background="#1B1F2A" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                        MouseLeftButtonUp="PaletteHint_Click" ToolTip="Search pages, actions, games and apps">
                    <DockPanel>
                        <TextBlock x:Name="PaletteKeyText" DockPanel.Dock="Right" Text="Ctrl+Alt+Space" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Search or run…" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="Dashboard"
                                     Tag="&#xE80F;" IsChecked="True" Checked="Nav_Checked"/>

                        <TextBlock Text="PLAY" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavGame" Style="{StaticResource NavButton}" Content="Game Mode"
                                     Tag="&#xE7FC;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}" Content="Game Library"
                                     Tag="&#xE8F1;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavClips" Style="{StaticResource NavButton}" Content="Clips &amp; Screenshots"
                                     Tag="&#xE714;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavCrosshair" Style="{StaticResource NavButton}" Content="Crosshair"
                                     Tag="&#xE710;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavController" Style="{StaticResource NavButton}" Content="Controller Tester"
                                     Tag="&#xE7FC;" Checked="Nav_Checked"/>

                        <TextBlock Text="EVERYDAY" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavClipboard" Style="{StaticResource NavButton}" Content="Clipboard &amp; Notes"
                                     Tag="&#xE77F;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavScreenTime" Style="{StaticResource NavButton}" Content="Screen Time"
                                     Tag="&#xE916;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDownloads" Style="{StaticResource NavButton}" Content="Downloads"
                                     Tag="&#xE896;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavInput" Style="{StaticResource NavButton}" Content="Input Stats"
                                     Tag="&#xE765;" Checked="Nav_Checked"/>

                        <TextBlock Text="CLEAN UP" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavCleaner" Style="{StaticResource NavButton}" Content="Junk Cleaner"
                                     Tag="&#xE74D;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDisk" Style="{StaticResource NavButton}" Content="Disk Space"
                                     Tag="&#xEDA2;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavUninstall" Style="{StaticResource NavButton}" Content="Uninstaller"
                                     Tag="&#xE7B8;" Checked="Nav_Checked"/>

                        <TextBlock Text="SPEED UP" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" Content="Startup Apps"
                                     Tag="&#xE7E8;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTweaks" Style="{StaticResource NavButton}" Content="Tweaks"
                                     Tag="&#xE9E9;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMenu" Style="{StaticResource NavButton}" Content="Right-click Menu"
                                     Tag="&#xE8A7;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavProcesses" Style="{StaticResource NavButton}" Content="Processes"
                                     Tag="&#xE9D9;" Checked="Nav_Checked"/>

                        <TextBlock Text="SYSTEM" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavHardware" Style="{StaticResource NavButton}" Content="Hardware"
                                     Tag="&#xE950;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavNetwork" Style="{StaticResource NavButton}" Content="Network"
                                     Tag="&#xE968;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSecurity" Style="{StaticResource NavButton}" Content="Security"
                                     Tag="&#xEA18;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" Content="Apps"
                                     Tag="&#xE719;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavButton}" Content="Tools"
                                     Tag="&#xE90F;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Settings"
                                     Tag="&#xE713;" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Faint accent glow in the top-right corner of the content area -->
        <Border Grid.Column="1" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.7" RadiusY="0.6">
                    <GradientStop Color="#1A4F8CFF" Offset="0"/>
                    <GradientStop Color="#004F8CFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Column="1" x:Name="Pages">
            <views:DashboardView x:Name="DashboardPage"/>
            <views:GameModeView x:Name="GamePage" Visibility="Collapsed"/>
            <views:LibraryView x:Name="LibraryPage" Visibility="Collapsed"/>
            <views:ClipsView x:Name="ClipsPage" Visibility="Collapsed"/>
            <views:ClipboardView x:Name="ClipboardPage" Visibility="Collapsed"/>
            <views:ScreenTimeView x:Name="ScreenTimePage" Visibility="Collapsed"/>
            <views:CrosshairView x:Name="CrosshairPage" Visibility="Collapsed"/>
            <views:ControllerView x:Name="ControllerPage" Visibility="Collapsed"/>
            <views:DownloadsView x:Name="DownloadsPage" Visibility="Collapsed"/>
            <views:InputStatsView x:Name="InputPage" Visibility="Collapsed"/>
            <views:CleanerView x:Name="CleanerPage" Visibility="Collapsed"/>
            <views:DiskView x:Name="DiskPage" Visibility="Collapsed"/>
            <views:NetworkView x:Name="NetworkPage" Visibility="Collapsed"/>
            <views:ContextMenuView x:Name="MenuPage" Visibility="Collapsed"/>
            <views:SecurityView x:Name="SecurityPage" Visibility="Collapsed"/>
            <views:HardwareView x:Name="HardwarePage" Visibility="Collapsed"/>
            <views:StartupView x:Name="StartupPage" Visibility="Collapsed"/>
            <views:ProcessesView x:Name="ProcessesPage" Visibility="Collapsed"/>
            <views:TweaksView x:Name="TweaksPage" Visibility="Collapsed"/>
            <views:AppsView x:Name="AppsPage" Visibility="Collapsed"/>
            <views:UninstallView x:Name="UninstallPage" Visibility="Collapsed"/>
            <views:ToolsView x:Name="ToolsPage" Visibility="Collapsed"/>
            <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
