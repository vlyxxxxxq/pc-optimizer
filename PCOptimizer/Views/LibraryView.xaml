<UserControl x:Class="PCOptimizer.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="Game Mode on launch" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="GameModeSwitch" Style="{StaticResource Switch}" Click="GameModeSwitch_Click"
                              ToolTip="Turn on Game Mode when you start a game from here"/>
                </StackPanel>
                <TextBlock Text="Game Library" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Every installed game from Steam, Epic and GOG in one place. Click a cover to play."/>
            <DockPanel Margin="0,18,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton x:Name="SortRecent" Content="Recent" GroupName="LibSort" IsChecked="True" Checked="Sort_Checked" Margin="0,0,6,0"/>
                    <RadioButton x:Name="SortPlayed" Content="Most played" GroupName="LibSort" Checked="Sort_Checked" Margin="0,0,6,0"/>
                    <RadioButton x:Name="SortName" Content="A–Z" GroupName="LibSort" Checked="Sort_Checked" Margin="0,0,12,0"/>
                    <Button Content="Refresh" Click="Refresh_Click"/>
                </StackPanel>
                <Grid Width="280" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="SearchHint" Text="Search games" Style="{StaticResource Muted}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </DockPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Games">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Play_Click" Margin="0,0,14,16" Cursor="Hand" ToolTip="{Binding Name}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel Width="150">
                                        <Border x:Name="Frame" Width="150" Height="225" CornerRadius="8" ClipToBounds="True"
                                                Background="{StaticResource CardBrush}" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontSize="56" FontWeight="SemiBold" Foreground="#3A4560"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"
                                                           VerticalAlignment="Bottom" Margin="10,0,10,16"/>
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                                <!-- Play badge on hover -->
                                                <Border x:Name="PlayBadge" Width="54" Height="54" CornerRadius="27" Background="#E64F8CFF" Opacity="0"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                </Border>
                                                <Border CornerRadius="4" Background="#CC0F1117" Padding="6,2" Margin="6"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Store}" FontSize="10" FontWeight="SemiBold" Foreground="#C9D4F0"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Margin="2,8,2,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PlayedText}" Margin="2,1,2,0" Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PlayBadge" Property="Opacity" Value="1"/>
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play" Click="Play_Click"/>
                                    <MenuItem Header="Open install folder" Click="Folder_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
