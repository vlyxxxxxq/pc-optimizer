<UserControl x:Class="PCOptimizer.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Stat" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Network" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Check your ping and stability to game servers, find the fastest DNS, and test your download speed."/>

            <!-- Connection -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <DockPanel>
                    <TextBlock x:Name="ConnIcon" Text="&#xE839;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel>
                        <TextBlock x:Name="ConnTitle" Text="Connection" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ConnDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Ping -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="PingButton" DockPanel.Dock="Right" Content="Start" Style="{StaticResource PrimaryButton}"
                                Click="Ping_Click" MinWidth="90"/>
                        <TextBox x:Name="HostBox" DockPanel.Dock="Right" Width="220" Margin="0,0,10,0" Text="1.1.1.1"
                                 VerticalContentAlignment="Center" ToolTip="Any server name or IP"/>
                        <StackPanel>
                            <TextBlock Text="Ping &amp; stability" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                       Text="Jitter (how much ping jumps around) and packet loss matter more for games than raw ping."/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl x:Name="HostPresets" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Key}" Tag="{Binding Value}" Click="Preset_Click" Padding="12,4" Margin="0,6,8,0" FontSize="12"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <UniformGrid Columns="5" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="NOW" Style="{StaticResource CardLabel}"/><TextBlock x:Name="PingNow" Text="–" Style="{StaticResource Stat}"/></StackPanel>
                        <StackPanel><TextBlock Text="AVERAGE" Style="{StaticResource CardLabel}"/><TextBlock x:Name="PingAvg" Text="–" Style="{StaticResource Stat}"/></StackPanel>
                        <StackPanel><TextBlock Text="BEST / WORST" Style="{StaticResource CardLabel}"/><TextBlock x:Name="PingRange" Text="–" Style="{StaticResource Stat}"/></StackPanel>
                        <StackPanel><TextBlock Text="JITTER" Style="{StaticResource CardLabel}"/><TextBlock x:Name="PingJitter" Text="–" Style="{StaticResource Stat}"/></StackPanel>
                        <StackPanel><TextBlock Text="PACKET LOSS" Style="{StaticResource CardLabel}"/><TextBlock x:Name="PingLoss" Text="–" Style="{StaticResource Stat}"/></StackPanel>
                    </UniformGrid>
                    <Grid Height="110" Margin="0,14,0,0">
                        <Border BorderBrush="#232836" BorderThickness="0,0,0,1"/>
                        <Canvas x:Name="PingChart" ClipToBounds="True">
                            <Polygon x:Name="PingFill" Fill="{StaticResource AccentBrush}" Opacity="0.16"/>
                            <Polyline x:Name="PingLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                        </Canvas>
                        <TextBlock x:Name="ChartScale" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock x:Name="PingVerdict" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- DNS -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="DnsButton" DockPanel.Dock="Right" Content="Test DNS" Style="{StaticResource PrimaryButton}"
                                    Click="Dns_Click"/>
                            <StackPanel>
                                <TextBlock Text="DNS speed" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DnsText" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="DNS turns names like discord.com into addresses. A faster one makes sites and launchers connect quicker."/>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl x:Name="DnsList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12,8" Margin="0,6,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Use" Tag="{Binding}" Click="UseDns_Click" Padding="12,4"
                                                    Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding AvgText}" FontWeight="SemiBold" Width="70"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Provider.Name}" FontWeight="SemiBold"/>
                                                    <Border Style="{StaticResource Badge}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="In use" FontSize="11" Foreground="{StaticResource GoodBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}">
                                                    <Run Text="{Binding Provider.Primary, Mode=OneWay}"/> <Run Text="{Binding Provider.Secondary, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AutoDnsButton" Content="Back to automatic DNS (from your router)" Click="AutoDns_Click"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5"/>
                    </StackPanel>
                </Border>

                <!-- Speed test -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Download speed" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Downloads 50 MB from Cloudflare's speed test server."/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock x:Name="SpeedText" Text="–" FontSize="44" FontWeight="Bold"/>
                            <TextBlock Text=" Mbps" FontSize="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                        </StackPanel>
                        <TextBlock x:Name="SpeedDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <Button x:Name="SpeedButton" Content="Run speed test" Style="{StaticResource PrimaryButton}"
                                Click="Speed_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
