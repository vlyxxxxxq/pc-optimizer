<UserControl x:Class="PCOptimizer.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PCOptimizer.Views">
    <UserControl.Resources>
        <!-- Segmented tab buttons -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="DiskTabs"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="7" Padding="14,6" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222736"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3550"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Disk Space" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="See exactly what's filling your drive. Click a block in the map to find it in the tree. Press Del to send selected items to the Recycle Bin."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,0">
            <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan" Style="{StaticResource PrimaryButton}"
                    Click="Scan_Click" MinWidth="90"/>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="0,0,10,0"/>
            <Button DockPanel.Dock="Right" Click="Up_Click" Margin="0,0,10,0" ToolTip="Parent folder">
                <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            </Button>
            <ItemsControl x:Name="DriveButtons" DockPanel.Dock="Right" Margin="0,0,10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Tag="{Binding}" Click="Drive_Click" Margin="0,0,6,0" Padding="12,8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="PathBox" Margin="0,0,10,0" VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown"/>
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,10">
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="13"
                       Text="Pick a folder or drive and click Scan."/>
            <ProgressBar x:Name="Progress" Height="3" Margin="0,8,0,0" Visibility="Hidden"/>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="Del → Recycle Bin   ·   ←/→ collapse/expand"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="3" HorizontalAlignment="Left"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabTree" Style="{StaticResource Tab}" Content="Folders" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabFiles" Style="{StaticResource Tab}" Content="Largest files" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabDupes" Style="{StaticResource Tab}" Content="Duplicates" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Folders: tree + treemap -->
        <Grid x:Name="TreePanel" Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="120"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="2*" MinHeight="100"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="TreeGrid" SelectionMode="Extended" CanUserSortColumns="False" RowHeight="30"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="TreeGrid_SelectionChanged" PreviewKeyDown="TreeGrid_PreviewKeyDown"
                          MouseDoubleClick="TreeGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                        <Button Width="22" Height="22" Padding="0" Background="Transparent" Focusable="False"
                                                Click="Expander_Click" Tag="{Binding}"
                                                Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ExpandGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        </Button>
                                        <Border Width="22" Visibility="{Binding NoExpander, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding TypeGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="{Binding TypeBrush}" FontSize="14" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Size" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="% of parent" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource Muted}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                <DockPanel>
                    <TextBlock x:Name="HoverText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="4,6,4,0"
                               TextTrimming="CharacterEllipsis" Text="Hover over the map to see what each block is."/>
                    <views:Treemap x:Name="Map" Cursor="Hand"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Largest files -->
        <Border x:Name="FilesPanel" Grid.Row="4" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,12,14,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RevealButton" Content="Open location" Click="Reveal_Click" Margin="0,0,8,0"
                                Padding="12,6" IsEnabled="False"/>
                        <Button x:Name="DeleteButton" Content="Move to Recycle Bin" Style="{StaticResource DangerButton}"
                                Click="DeleteFiles_Click" Padding="12,6" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock Text="The 200 biggest files in the scan. Select several with Ctrl or Shift." Style="{StaticResource Muted}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="FileGrid" SelectionMode="Extended" SelectionChanged="FileGrid_SelectionChanged"
                          PreviewKeyDown="FileGrid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="95"/>
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Duplicates -->
        <Border x:Name="DupesPanel" Grid.Row="4" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,12,14,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="FindDupesButton" Content="Find duplicates" Style="{StaticResource PrimaryButton}"
                                Click="FindDupes_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button x:Name="TickExtrasButton" Content="Tick extra copies" Click="TickExtras_Click"
                                Padding="12,6" Margin="0,0,8,0" IsEnabled="False"
                                ToolTip="Keeps the newest copy of each file and ticks the rest"/>
                        <Button x:Name="RecycleDupesButton" Content="Recycle ticked" Style="{StaticResource DangerButton}"
                                Click="RecycleDupes_Click" Padding="12,6" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="DupesText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Finds identical files (1 MB or larger) under the folder above by comparing their contents."/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DupeList" Margin="14,0,14,14" VirtualizingPanel.IsVirtualizing="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" Click="DupeCheck_Click"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ModifiedText}" Style="{StaticResource Muted}"
                                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip="{Binding FullPath}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
