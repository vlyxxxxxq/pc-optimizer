<UserControl x:Class="PCOptimizer.Views.ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="Controller Tester" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Check every button, stick drift and trigger range, and test the rumble motors. Works with Xbox controllers and anything that acts like one."/>

            <DockPanel Margin="0,18,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" x:Name="Slots">
                    <RadioButton Content="Controller 1" GroupName="Pad" Tag="0" IsChecked="True" Checked="Slot_Checked" Margin="0,0,6,0"/>
                    <RadioButton Content="Controller 2" GroupName="Pad" Tag="1" Checked="Slot_Checked" Margin="0,0,6,0"/>
                    <RadioButton Content="Controller 3" GroupName="Pad" Tag="2" Checked="Slot_Checked" Margin="0,0,6,0"/>
                    <RadioButton Content="Controller 4" GroupName="Pad" Tag="3" Checked="Slot_Checked" Margin="0,0,6,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!-- Sticks and triggers -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="STICKS &amp; TRIGGERS" Style="{StaticResource CardLabel}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <!-- Left trigger -->
                            <Border Width="14" Height="140" CornerRadius="7" Background="{StaticResource InputBrush}" VerticalAlignment="Center">
                                <Border x:Name="LTBar" VerticalAlignment="Bottom" CornerRadius="7" Background="{StaticResource AccentBrush}" Height="0"/>
                            </Border>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <Canvas x:Name="LeftStick" Width="140" Height="140"/>
                                <TextBlock x:Name="LeftText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Canvas x:Name="RightStick" Width="140" Height="140"/>
                                <TextBlock x:Name="RightText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                            </StackPanel>
                            <Border Grid.Column="3" Width="14" Height="140" CornerRadius="7" Background="{StaticResource InputBrush}" VerticalAlignment="Center">
                                <Border x:Name="RTBar" VerticalAlignment="Bottom" CornerRadius="7" Background="{StaticResource AccentBrush}" Height="0"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TriggerText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                    </StackPanel>
                </Border>
                <!-- Buttons -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="BUTTONS" Style="{StaticResource CardLabel}"/>
                        <WrapPanel x:Name="ButtonGrid" Margin="0,14,0,0"/>
                        <TextBlock x:Name="ButtonsTested" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Stick drift check" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Put the controller down and don't touch the sticks. A healthy stick rests near 0; more than about 10% off-centre is drift that games may pick up."/>
                        <Button x:Name="DriftButton" Content="Check for drift (5 s)" Click="Drift_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        <TextBlock x:Name="DriftText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Rumble" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="The left motor gives the heavy rumble, the right one the light buzz. Each test runs for one second."/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Heavy (left)" Tag="L" Click="Rumble_Click" Margin="0,0,8,0"/>
                            <Button Content="Light (right)" Tag="R" Click="Rumble_Click" Margin="0,0,8,0"/>
                            <Button Content="Both" Tag="B" Click="Rumble_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
