<UserControl x:Class="PCOptimizer.Views.AskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button x:Name="NewChatButton" DockPanel.Dock="Right" Content="New chat" Click="NewChat_Click" VerticalAlignment="Top"/>
                <TextBlock Text="Ask AI" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Ask anything about your PC. Each question includes a live snapshot (load, memory hogs, disks, health checks) so the answer is about your machine."/>

            <!-- API key: shown until one is saved -->
            <Border x:Name="KeyCard" Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Connect Claude" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Ask AI uses your own Anthropic API key (pay-as-you-go, a few cents per question). Create one at console.anthropic.com, then paste it here. It's stored encrypted for your Windows account only and never included in setup exports."/>
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Get a key" Click="GetKey_Click" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveKey_Click" Margin="8,0,0,0"/>
                        <PasswordBox x:Name="KeyBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                     Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource CardBorderBrush}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <DockPanel x:Name="KeyStatus" Margin="0,10,0,0" Visibility="Collapsed">
                <Button DockPanel.Dock="Right" Content="Remove key" Click="RemoveKey_Click" Padding="10,3"/>
                <TextBlock Text="● Connected to Claude" Foreground="{StaticResource GoodBrush}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <!-- Composer -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel x:Name="Suggestions" Margin="0,0,0,10">
                <Button Content="Why is my PC slow right now?" Click="Suggestion_Click" Margin="0,0,8,8"/>
                <Button Content="What's using all my memory?" Click="Suggestion_Click" Margin="0,0,8,8"/>
                <Button Content="How can I get more FPS?" Click="Suggestion_Click" Margin="0,0,8,8"/>
                <Button Content="Is my storage OK?" Click="Suggestion_Click" Margin="0,0,8,8"/>
                <Button Content="What should I clean up first?" Click="Suggestion_Click" Margin="0,0,8,8"/>
            </WrapPanel>
            <DockPanel>
                <Button x:Name="AskButton" DockPanel.Dock="Right" Content="Ask" Style="{StaticResource PrimaryButton}" Click="Ask_Click"
                        Margin="8,0,0,0" Padding="18,6" VerticalAlignment="Bottom"/>
                <Grid>
                    <TextBox x:Name="QuestionBox" AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="120" MinHeight="36"
                             VerticalContentAlignment="Center" Padding="8,6" KeyDown="Question_KeyDown" TextChanged="Question_Changed"/>
                    <TextBlock x:Name="QuestionHint" Text="Ask about your PC…" Style="{StaticResource Muted}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </DockPanel>
        </StackPanel>

        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel x:Name="Chat"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
