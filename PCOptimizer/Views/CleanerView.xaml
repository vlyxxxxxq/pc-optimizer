<UserControl x:Class="PCOptimizer.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Junk Cleaner" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Find and remove temporary files and caches. Files that are in use are skipped automatically."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,16">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ScanButton" Content="Scan" Click="Scan_Click" Margin="0,0,10,0" MinWidth="90"/>
                        <Button x:Name="CleanButton" Content="Clean selected" Style="{StaticResource PrimaryButton}"
                                Click="Clean_Click" IsEnabled="False" MinWidth="120"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TotalText" Text="Ready to scan" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="Scanning only measures files. Nothing is deleted until you click Clean."/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="Progress" Margin="0,14,0,0" Height="4"/>
                <!-- Automatic cleaning -->
                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                    <DockPanel>
                        <CheckBox x:Name="AutoSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Auto_Click"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <RadioButton x:Name="EveryDay" Content="Daily" GroupName="Every" Click="Interval_Click" Tag="1" Margin="0,0,12,0" Foreground="{StaticResource TextBrush}"/>
                            <RadioButton x:Name="EveryWeek" Content="Weekly" GroupName="Every" Click="Interval_Click" Tag="7" Margin="0,0,12,0" Foreground="{StaticResource TextBrush}"/>
                            <RadioButton x:Name="EveryMonth" Content="Monthly" GroupName="Every" Click="Interval_Click" Tag="30" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Clean automatically" FontSize="14"/>
                            <TextBlock x:Name="AutoText" Style="{StaticResource Muted}"
                                       Text="Runs in the background on the categories ticked by default (never the Recycle Bin), and never during a game."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <ItemsControl x:Name="CategoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="110">
                                    <TextBlock Text="{Binding SizeText}" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Browser privacy -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="PrivacyButton" DockPanel.Dock="Right" Content="Clear selected" Style="{StaticResource DangerButton}"
                                Click="ClearPrivacy_Click" IsEnabled="False" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Browser privacy" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PrivacyText" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Cookies and browsing history. Separate from the cache above because clearing cookies signs you out. Passwords, autofill and bookmarks are never touched."/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl x:Name="PrivacyList" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12,9" Margin="0,8,8,0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" Click="Privacy_Click"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Effect}" Style="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
