<UserControl x:Class="PCOptimizer.Views.ContextMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Right-click Menu" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Switch off the clutter apps add to Explorer's right-click menu. Nothing is uninstalled, and you can switch any item back on."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Show Windows items" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="ShowWindows" Style="{StaticResource Switch}" Click="ShowWindows_Click" Margin="0,0,16,0"/>
                <Button Content="Refresh" Click="Refresh_Click"/>
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
        </DockPanel>

        <Border x:Name="ExplorerBanner" Grid.Row="2" Margin="0,0,0,10" Padding="16,10" CornerRadius="8" Background="#2B2617"
                BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart Explorer" Click="RestartExplorer_Click" Padding="12,5"/>
                <TextBlock Text="Some changes show up after Windows Explorer restarts (your taskbar blinks for a second)."
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EntryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,9" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,6,0"
                                              IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanChange}"/>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                            Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Admin" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                    </Border>
                                    <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border CornerRadius="6" Background="#2A3040">
                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image x:Name="icon" Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
