<UserControl x:Class="PCOptimizer.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Uninstaller" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Remove programs you don't use. Each program's own uninstaller runs, so nothing is left half-removed."/>
        </StackPanel>

        <!-- Windows extras -->
        <Border x:Name="ExtrasCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="ExtrasToggle" DockPanel.Dock="Right" Content="Show" Click="ExtrasToggle_Click"
                            Padding="14,5" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="ExtrasTitle" Text="Windows extras you can remove" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="Preinstalled Microsoft Store apps. Removing one only affects your account, and any of them can be reinstalled from the Store."/>
                    </StackPanel>
                </DockPanel>
                <ItemsControl x:Name="ExtrasList" Margin="0,4,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="268" Margin="0,8,8,0" Padding="12,10" CornerRadius="8" Background="{StaticResource InputBrush}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Remove" Tag="{Binding}" Click="RemoveExtra_Click"
                                            Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" FontSize="11"
                                                   TextWrapping="Wrap" MaxHeight="30"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource WarnBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="2" Margin="0,16,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,10,0"/>
                <Button x:Name="LocationButton" Content="Open folder" Click="Location_Click" Margin="0,0,10,0" IsEnabled="False"/>
                <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource DangerButton}"
                        Click="Uninstall_Click" IsEnabled="False"/>
            </StackPanel>
            <Grid Width="260" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="30,6,8,6"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" IsHitTestVisible="False"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </DockPanel>

        <!-- Programs -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="Grid" RowHeight="50" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="SelectAllBox" Click="SelectAll_Click" ToolTip="Select every program in the list"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Click="RowCheck_Click" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Program" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border CornerRadius="6" Background="#2A3040">
                                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image x:Name="icon" Source="{Binding Icon}" Width="28" Height="28"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="100"/>
                    <DataGridTextColumn Header="Installed" Binding="{Binding InstalledText}" SortMemberPath="InstalledOn" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
