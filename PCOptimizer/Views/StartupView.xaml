<UserControl x:Class="PCOptimizer.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Startup Apps" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Fewer apps launching at sign-in means a faster boot. Disabling is reversible and works exactly like Task Manager's Startup tab."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,20,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,10,0"/>
                <Button x:Name="RevealButton" Content="Open location" Click="Reveal_Click" Margin="0,0,10,0" IsEnabled="False"/>
                <Button x:Name="EnableButton" Content="Enable" Click="Enable_Click" Margin="0,0,10,0" IsEnabled="False"/>
                <Button x:Name="DisableButton" Content="Disable" Style="{StaticResource PrimaryButton}"
                        Click="Disable_Click" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged" RowHeight="50"
                      MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="App" Width="300" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border x:Name="fallback" CornerRadius="6" Background="#2A3040">
                                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image x:Name="icon" Source="{Binding Icon}" Width="28" Height="28"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="240"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="240" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="IsEnabled">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="pill" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                                        Background="#1E3A2E">
                                    <TextBlock x:Name="label" Text="{Binding StatusText}" FontSize="12"
                                               Foreground="{StaticResource GoodBrush}"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter TargetName="pill" Property="Background" Value="#262B38"/>
                                        <Setter TargetName="label" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="200"/>
                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
