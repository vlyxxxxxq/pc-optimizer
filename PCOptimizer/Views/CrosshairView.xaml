<UserControl x:Class="PCOptimizer.Views.CrosshairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="Show now" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ShowSwitch" Style="{StaticResource Switch}" Click="ShowSwitch_Click"/>
                </StackPanel>
                <TextBlock Text="Crosshair" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="A custom crosshair in the centre of your screen. It turns on by itself in the games you pick and off when you leave them."/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!-- Preview on a busy background so contrast is easy to judge -->
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid Height="300">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5E7A8C" Offset="0"/>
                                <GradientStop Color="#C9B48A" Offset="0.45"/>
                                <GradientStop Color="#3E4A2F" Offset="0.55"/>
                                <GradientStop Color="#1C2116" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Canvas x:Name="Preview" Width="300" Height="300"/>
                        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#AAFFFFFF" Margin="12,10,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="STYLE" Style="{StaticResource CardLabel}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <RadioButton x:Name="ShapeCrossDot" Content="Cross + dot" GroupName="Shape" Tag="CrossDot" Click="Shape_Click" Margin="0,0,6,6"/>
                            <RadioButton x:Name="ShapeCross" Content="Cross" GroupName="Shape" Tag="Cross" Click="Shape_Click" Margin="0,0,6,6"/>
                            <RadioButton x:Name="ShapeDot" Content="Dot" GroupName="Shape" Tag="Dot" Click="Shape_Click" Margin="0,0,6,6"/>
                            <RadioButton x:Name="ShapeCircle" Content="Circle" GroupName="Shape" Tag="Circle" Click="Shape_Click" Margin="0,0,6,6"/>
                            <RadioButton x:Name="ShapeT" Content="T" GroupName="Shape" Tag="T" Click="Shape_Click" Margin="0,0,6,6"/>
                        </WrapPanel>

                        <TextBlock Text="COLOUR" Style="{StaticResource CardLabel}" Margin="0,12,0,0"/>
                        <WrapPanel x:Name="Swatches" Margin="0,8,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Size" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="1" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_Changed" Margin="0,6"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SizeSlider}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="Thickness" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider x:Name="ThickSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_Changed" Margin="0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=ThickSlider}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Gap" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider x:Name="GapSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_Changed" Margin="0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=GapSlider}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="Opacity" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider x:Name="OpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="Slider_Changed" Margin="0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat=P0}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <DockPanel Margin="0,8,0,0">
                            <CheckBox x:Name="OutlineSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Outline_Click"/>
                            <TextBlock Text="Black outline (easier to see on bright scenes)" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Games -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add another game…" Click="AddGame_Click" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="Turn on automatically in" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GamesHint" Style="{StaticResource Muted}" Margin="0,2,16,0" TextWrapping="Wrap"
                                       Text="The crosshair appears while one of these games is the window you're playing, and disappears when you alt-tab out or close it."/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel x:Name="GameList" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="HotkeyButton" DockPanel.Dock="Right" Click="Hotkey_Click" PreviewKeyDown="Hotkey_PreviewKeyDown"
                                LostKeyboardFocus="Hotkey_LostFocus" Padding="10,3" ToolTip="Click, then press the keys you want"/>
                        <StackPanel>
                            <TextBlock Text="Toggle hotkey" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HotkeyText" Style="{StaticResource Muted}" Margin="0,2,16,0" TextWrapping="Wrap"
                                       Text="Show or hide the crosshair from inside any game."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"
                               Text="Works over borderless and windowed games (exclusive fullscreen draws over everything). It's a separate window that never touches the game, but some competitive games' rules forbid crosshair overlays, so check before using it in ranked."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
